model Farm {
  id                         String                         @id @default(uuid())
  farmerId                   String
  name                       String
  description                String?
  landSize                   Float
  landUnit                   LandUnit                       @default(HECTARE)
  ownershipType              OwnershipType                  @default(OWNED)
  soilType                   SoilType                       @default(UNKNOWN)
  status                     FarmStatus                     @default(ACTIVE)
  province                   String?
  district                   String
  sector                     String?
  cell                       String?
  village                    String?
  latitude                   Float?
  longitude                  Float?
  locationSource             FarmLocationSource             @default(ADDRESS_ONLY)
  locationAccuracyMeters     Float?
  locationCapturedAt         DateTime?
  locationVerificationStatus FarmLocationVerificationStatus @default(UNVERIFIED)
  locationVerifiedAt         DateTime?
  locationVerifiedById       String?
  locationVerificationNote   String?
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  crops                      Crop[]
  farmer                     Farmer                         @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  locationVerifiedBy         User?                          @relation("FarmLocationVerifier", fields: [locationVerifiedById], references: [id], onDelete: SetNull)

  @@index([farmerId])
  @@index([district])
  @@index([sector])
  @@index([ownershipType])
  @@index([soilType])
  @@index([status])
  @@index([locationSource])
  @@index([locationVerificationStatus])
  @@index([locationVerifiedById])
  @@index([createdAt])
}

enum LandUnit {
  HECTARE
  ACRE
  SQUARE_METER
}

enum OwnershipType {
  OWNED
  RENTED
  FAMILY_LAND
  COOPERATIVE_LAND
  GOVERNMENT_ALLOCATED
  OTHER
}

enum SoilType {
  CLAY
  SANDY
  SILT
  LOAM
  PEAT
  CHALKY
  UNKNOWN
}

enum FarmStatus {
  ACTIVE
  INACTIVE
  UNDER_REVIEW
}

enum FarmLocationSource {
  ADDRESS_ONLY
  GPS_BROWSER
  GPS_DEVICE
  MAP_PIN
  FIELD_OFFICER
  COOPERATIVE_MANAGER
  ADMIN
}

enum FarmLocationVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}
