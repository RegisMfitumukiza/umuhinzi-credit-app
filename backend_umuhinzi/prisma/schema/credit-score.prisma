enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum CreditScoreFactorType {
  YIELD_CONSISTENCY
  FARMING_HISTORY
  INCOME_STABILITY
  REPAYMENT_BEHAVIOR
  PRODUCTIVITY
  FARM_SIZE
  LIVESTOCK_VALUE
  COOPERATIVE_MEMBERSHIP
  DATA_COMPLETENESS
}

model CreditScore {
  id String @id @default(uuid())

  // Farmer relationship
  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  // Final score
  score     Int
  riskLevel RiskLevel

  // Breakdown scores
  yieldConsistencyScore   Float @default(0)
  farmingHistoryScore     Float @default(0)
  incomeStabilityScore    Float @default(0)
  repaymentBehaviorScore  Float @default(0)
  productivityScore       Float @default(0)
  dataCompletenessScore   Float @default(0)

  // Explanation
  summary String?

  generatedAt DateTime @default(now())

  // Relations
  factors         CreditScoreFactor[]
  riskAssessment  RiskAssessment?
  loanApplications LoanApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmerId])
  @@index([score])
  @@index([riskLevel])
  @@index([generatedAt])
}

model CreditScoreFactor {
  id String @id @default(uuid())

  creditScoreId String
  creditScore   CreditScore @relation(fields: [creditScoreId], references: [id], onDelete: Cascade)

  type        CreditScoreFactorType
  factorName  String
  factorValue Float
  weight      Float
  contribution Float

  description String?

  createdAt DateTime @default(now())

  @@index([creditScoreId])
  @@index([type])
}

model RiskAssessment {
  id String @id @default(uuid())

  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  creditScoreId String @unique
  creditScore   CreditScore @relation(fields: [creditScoreId], references: [id], onDelete: Cascade)

  riskLevel RiskLevel

  reason            String?
  recommendedAction String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmerId])
  @@index([riskLevel])
}