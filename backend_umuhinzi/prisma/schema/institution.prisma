model Institution {
  id                 String            @id @default(uuid())
  userId             String            @unique
  name               String
  type               InstitutionType
  registrationNumber String?           @unique
  licenseNumber      String?           @unique
  email              String?
  phone              String?
  address            String?
  province           String?
  district           String?
  sector             String?
  cell               String?
  village            String?
  status             InstitutionStatus @default(PENDING)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  loans              Loan[]
  loanApplications   LoanApplication[]
  staff              InstitutionStaff[]

  @@index([type])
  @@index([status])
  @@index([district])
  @@index([sector])
  @@index([createdAt])
}

model InstitutionStaff {
  id            String                 @id @default(uuid())
  institutionId String
  userId        String
  role          InstitutionStaffRole   @default(LOAN_OFFICER)
  status        InstitutionStaffStatus @default(ACTIVE)
  addedAt       DateTime               @default(now())
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  institution   Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([institutionId, userId])
  @@index([institutionId])
  @@index([userId])
  @@index([status])
}

enum InstitutionType {
  SACCO
  MICROFINANCE
  BANK
  NGO
  GOVERNMENT_PROGRAM
  OTHER
}

enum InstitutionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum InstitutionStaffRole {
  ADMIN
  LOAN_OFFICER
  VIEWER
}

enum InstitutionStaffStatus {
  ACTIVE
  REMOVED
}
