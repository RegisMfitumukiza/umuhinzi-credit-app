enum InstitutionType {
  SACCO
  MICROFINANCE
  BANK
  NGO
  GOVERNMENT_PROGRAM
  OTHER
}

enum InstitutionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model Institution {
  id String @id @default(uuid())

  // User relationship
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Institution details
  name              String
  type              InstitutionType
  registrationNumber String? @unique
  licenseNumber      String? @unique

  // Contact information
  email   String?
  phone   String?
  address String?

  // Location
  province String?
  district String?
  sector   String?
  cell     String?
  village  String?

  // Status
  status InstitutionStatus @default(PENDING)

  // Relations
  loanApplications LoanApplication[]
  loans            Loan[]

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([district])
  @@index([sector])
  @@index([createdAt])
}