enum YieldQualityGrade {
  EXCELLENT
  GOOD
  AVERAGE
  POOR
  DAMAGED
}

model YieldRecord {
  id String @id @default(uuid())

  // Crop relationship
  cropId String
  crop   Crop   @relation(fields: [cropId], references: [id], onDelete: Cascade)

  // Yield details
  expectedYield Float?
  actualYield   Float

  unit String @default("kg")

  harvestDate DateTime

  qualityGrade YieldQualityGrade @default(AVERAGE)

  notes String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cropId])
  @@index([harvestDate])
  @@index([qualityGrade])
  @@index([createdAt])
}

model ProductivityRecord {
  id String @id @default(uuid())

  // Farmer relationship
  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  // Season relationship
  seasonId String
  season   FarmingSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  totalExpectedYield Float?
  totalActualYield   Float

  unit String @default("kg")

  productivityRate Float

  notes String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmerId, seasonId])
  @@index([farmerId])
  @@index([seasonId])
  @@index([productivityRate])
  @@index([createdAt])
}