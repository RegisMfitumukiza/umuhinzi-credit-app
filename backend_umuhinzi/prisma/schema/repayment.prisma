enum RepaymentScheduleStatus {
  UPCOMING
  DUE
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  MOBILE_MONEY
  BANK_TRANSFER
  CASH
  CARD
  OTHER
}

enum RepaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

model RepaymentSchedule {
  id String @id @default(uuid())

  // Loan relationship
  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)

  dueDate        DateTime
  expectedAmount Float
  paidAmount     Float @default(0)

  status RepaymentScheduleStatus @default(UPCOMING)

  notes String?

  // Relations
  repayments Repayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loanId])
  @@index([dueDate])
  @@index([status])
  @@index([createdAt])
}

model Repayment {
  id String @id @default(uuid())

  // Loan relationship
  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)

  // Optional schedule relationship
  repaymentScheduleId String?
  repaymentSchedule   RepaymentSchedule? @relation(fields: [repaymentScheduleId], references: [id], onDelete: SetNull)

  amountPaid Float

  paymentMethod PaymentMethod
  status        RepaymentStatus @default(COMPLETED)

  transactionReference String? @unique

  paidAt DateTime @default(now())

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loanId])
  @@index([repaymentScheduleId])
  @@index([paymentMethod])
  @@index([status])
  @@index([paidAt])
}