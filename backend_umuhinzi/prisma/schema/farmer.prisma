enum Gender {
    MALE
    FEMALE
    OTHER
}

enum FarmerStatus {
    PENDING
    VERIFIED
    SUSPENDED
}

enum CredibilityStatus {
    LOW
    MEDIUM
    HIGH
    TRUSTED
}

model Farmer {
    id String @id @default(uuid())

    // User relationship
    userId String @unique
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    // Personal information
    nationalId  String    @unique
    dateOfBirth DateTime?
    gender      Gender?

    // Farming profile
    farmingExperienceYears Int?    @default(0)
    primaryCrop            String?

    // Trust profile
    credibilityStatus CredibilityStatus @default(LOW)

    // Verification
    status FarmerStatus @default(PENDING)

    // Cooperative
    cooperativeId String?

    cooperative Cooperative? @relation(fields: [cooperativeId], references: [id])

    cooperativeMembership CooperativeMember?

    // Relations
    farms   Farm[]
    livestock Livestock[]

    financialSummaries  FinancialSummary[]
    farmExpenses       FarmExpense[]
    productivityRecords ProductivityRecord[]

    creditScores    CreditScore[]
    riskAssessments RiskAssessment[]

    loanApplications LoanApplication[]
    loans            Loan[]

    recommendations Recommendation[]

    // Audit
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([cooperativeId])
    @@index([credibilityStatus])
    @@index([status])
    @@index([primaryCrop])
}
