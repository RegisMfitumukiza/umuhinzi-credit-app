enum InputType {
  SEED
  FERTILIZER
  PESTICIDE
  HERBICIDE
  LABOR
  IRRIGATION
  TRANSPORT
  EQUIPMENT
  STORAGE
  OTHER
}

model InputCost {
  id String @id @default(uuid())

  // Crop relationship
  cropId String
  crop   Crop   @relation(fields: [cropId], references: [id], onDelete: Cascade)

  // Input details
  type        InputType
  name        String
  description String?

  quantity Float?
  unit     String?

  unitCost  Float?
  totalCost Float

  dateUsed DateTime

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cropId])
  @@index([type])
  @@index([dateUsed])
  @@index([createdAt])
}