{
  "info": {
    "name": "Umuhinzi - Farms API",
    "_postman_id": "a1b2c3d4-e5f6-4789-abcd-ef0123456789",
    "description": "Collection to test Farms endpoints (create/list/get/update/delete)\nImport the accompanying environment to set `baseUrl` and `token`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Farm",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo Farm\",\n  \"size\": 2.5,\n  \"unit\": \"HECTARE\",\n  \"location\": \"Rwanda, Kigali\",\n  \"ownershipType\": \"OWN\",\n  \"soilType\": \"LOAMY\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/farms", "host": ["{{baseUrl}}"], "path": ["api","farms"] }
      }
    },
    {
      "name": "List My Farms",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/farms/me?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api","farms","me"], "query": [ { "key": "page", "value": "1" }, { "key": "limit", "value": "10" } ] }
      }
    },
    {
      "name": "Get Farm by ID",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/farms/:id", "host": ["{{baseUrl}}"], "path": ["api","farms",":id"] }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Replace :id in the URL with the selected variable 'farmId' if set",
              "if (pm.environment.get('farmId')) {",
              "  pm.request.url = pm.request.url.toString().replace(':id', pm.environment.get('farmId'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Update Farm",
      "request": {
        "method": "PATCH",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Farm Name\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/farms/:id", "host": ["{{baseUrl}}"], "path": ["api","farms",":id"] }
      },
      "event": [ { "listen": "prerequest", "script": { "exec": [ "if (pm.environment.get('farmId')) { pm.request.url = pm.request.url.toString().replace(':id', pm.environment.get('farmId')); }" ] } } ]
    },
    {
      "name": "Delete Farm",
      "request": {
        "method": "DELETE",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/farms/:id", "host": ["{{baseUrl}}"], "path": ["api","farms",":id"] }
      },
      "event": [ { "listen": "prerequest", "script": { "exec": [ "if (pm.environment.get('farmId')) { pm.request.url = pm.request.url.toString().replace(':id', pm.environment.get('farmId')); }" ] } } ]
    },
    {
      "name": "Admin - List All Farms",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/admin/farms?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["api","admin","farms"], "query": [ { "key": "page", "value": "1" }, { "key": "limit", "value": "20" } ] }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "farmId", "value": "" }
  ]
}
